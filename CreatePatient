const axios = require('axios');
const axiosRetry = require('axios-retry').default;
const athena = require('./AthenaClient');
const practiceid = athena.getPracticeId(1);
// Configure axios-retry
axiosRetry(axios, {
    retries: 1,
    retryDelay: (retryCount) => retryCount * 100,
    retryCondition: (error) => axiosRetry.isRetryableError(error) || error.code === 'ECONNABORTED',
});

exports.handler = async (event) => {
    try {
        console.log('Received Event:', JSON.stringify(event));

        if (!event.body) {
            return formatResponse(400, { error: "Missing or empty request body" });
        }
        let payload;
        try {
            payload = JSON.parse(event.body);
        } catch (error) {
            console.error("Failed to parse JSON:", error.message);
            return formatResponse(400, { error: "Invalid JSON format" });
        }

        const token = await athena.getToken();

        const { firstName, lastName, phone, dateOfBirth } = payload.args;

        const response = await createNewPatient(token, firstName, lastName, phone, dateOfBirth, 1);
        console.log('Patient created successfully:', response);
        return formatResponse(200, { message: 'Patient created successfully', data: response });
    } catch (error) {
        console.error('Error in handler:', error.message);
        return formatResponse(500, { error: 'Internal Server Error' });
    }
};

// Token retrieval moved to AthenaClient.getToken()

const createNewPatient = async (token, firstName, lastName, phone, dateOfBirth, departmentid) => {
    const url = `${athena.getBaseUrl()}/v1/${practiceid}/patients`;
    const headers = {
        'Authorization': `Bearer ${token.access_token}`,
        'Content-Type': 'application/x-www-form-urlencoded',
    };

    if (departmentid === undefined || departmentid === null || !departmentid || !Number.isInteger(Number(departmentid))) {
        departmentid = 1;
    }

    console.log('phone number:', phone);

    const body = new URLSearchParams({
        departmentid: departmentid,
        dob: typeof dateOfBirth === 'string' ? dateOfBirth.trim() : '',
        lastname: lastName,
        firstname: firstName,
        mobilephone: phone,
        preferredname: firstName,
    });

    try {
        const response = await axios.post(url,body.toString(),{headers, timeout: 350000 });
        return response.data;
    } catch (error) {
        if (error.response) {
            console.error('Error Response:', error.response.data);
            return { error: error.response.data.message || 'Unknown error from Athena API' };
        } else if (error.request) {
            console.error('Network Error:', error.message);
            return { error: 'Network Error: Failed to send request' };
        } else {
            console.error('Unexpected Error:', error.message);
            return { error: 'Unexpected Error: Failed to process request' };
        }
    }
};

const validateDateOfBirth = (dob) => {
    const dobRegex = /^(0[1-9]|1[0-2])\/([0-2][0-9]|3[01])\/\d{4}$/;
    if (!dobRegex.test(dob)) return false;

    const [month, day, year] = dob.split('/').map(Number);
    const date = new Date(year, month - 1, day);
    return date && date.getFullYear() === year && date.getMonth() + 1 === month && date.getDate() === day;
};

const formatResponse = (statusCode, body) => ({
    statusCode,
    body: JSON.stringify(body),
});

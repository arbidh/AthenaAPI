const getProviders = async (fname, lname) => {
     if (!cachedToken) {
         cachedToken = await athena.getToken();
     }

    const url = `${athena.getBaseUrl()}/v1/17568/providers?limit=5&name=${fname}`;
    
    try {
        const response = await axios.get(url, {
            headers: { Authorization: `Bearer ${cachedToken.access_token}` },
        });

        console.log("📌 Providers found:", response.data);

        // Check if providers exist
        if (!response.data.providers || response.data.providers.length === 0) {
            throw new Error("No providers found");
        }

        // Find provider with exact first name and last name
        const matchedProvider = response.data.providers.find(
            provider => provider.firstname === fname && provider.lastname === lname
        );

        // Return the matched provider's ID or fallback to the first provider's ID
        return matchedProvider ? matchedProvider.providerid : response.data.providers[0].providerid;

    } catch (error) {
        console.error("❌ Error finding providers:", error.response?.data || error.message);
        throw new Error(`Didn't Find any providers ${error.message}`);
    }
};


const findSlots = async (providerid,appointmentDate,appointmentTime, patientid, reasonid) => {

    const departmentid = 1;
    const today = new Date();
    const twoMonthsFromNow = new Date();
;
    
    console.log(`🔍 Finding slots for patient ${patientid} from ${formatDate(today)} to ${formatDate(twoMonthsFromNow)}`);

    if (!cachedToken) {
        throw new Error("Missing auth token");
    }

    const url = `${athena.getBaseUrl()}/v1/${practiceid}/appointments/open`;
    console.log("🔍 slotProvierid:", providerid);
    console.log("🔍 slotDepartmentid:", departmentid);
    console.log("🔍 slotReasonid:", reasonid)
    console.log("🔍 slotAppointmentDate:", appointmentDate);
    console.log("🔍 slotPatientid:", patientid);
    try {
        const response = await axios.get(url, {
            headers: { Authorization: `Bearer ${cachedToken.access_token}` },
            params: {
                providerid,
                departmentid,
                startdate: appointmentDate,
                time: appointmentTime,
                reasonid: reasonid, 
                bypasscheduletimechecks: true,
                ignoreschedulablepermission: true

            }
        });

        console.log("📌 Slots found:", response.data);

        let availableSlots = response.data.appointments || [];

        if (!availableSlots.length) {
            console.log("⚠️ No available slots found.");
            return null; // No slots found
        }

        // console.log("✅ Available slots:", availableSlots);

        let exactMatch = availableSlots.find(slot => slot.date === appointmentDate);
        if (exactMatch && exactMatch.appointmentid) {
            console.log("🎯 Exact match found:", exactMatch);
            return exactMatch;
        }

        let closestSlot = availableSlots.sort((a, b) => new Date(a.date) - new Date(b.date))[0];

        if (!closestSlot || !closestSlot.appointmentid) {
            console.error("❌ Error: No valid slot found after filtering.");
            return null;
        }

        console.log("⏳ Closest available slot selected:", closestSlot);
        return closestSlot;
    } catch (error) {
        console.error("❌ Error finding slots:", error.response?.data || error.message);
        throw new Error("Failed to fetch available slots");
    }
};

const getPatientAppointmentReasons = async (providerid, departmentid, existing) => {
    const provideridInt = parseInt(providerid, 10);
    const departmentidInt = parseInt(departmentid, 10);
    console.log("🔍 Fetching appointment reasons for provider:", provideridInt, "department:", departmentidInt);
    let url = `${athena.getBaseUrl()}/v1/${practiceid}/patientappointmentreasons/newpatient?providerid=${provideridInt}&departmentid=${departmentidInt}`;
    if (existing) {
        url = `${athena.getBaseUrl()}/v1/${practiceid}/patientappointmentreasons/existingpatient?providerid=${provideridInt}&departmentid=${departmentidInt}`;
    }

    if (!cachedToken) {
        cachedToken = await athena.getToken();
    }

    try {
        const response = await axios.get(url, { headers: { Authorization: `Bearer ${cachedToken.access_token}` } });
        return response.data.patientappointmentreasons;
    } catch (error) {
        console.error("Error fetching appointment reasons:", error.response ? error.response.data : error);
        throw new Error("Failed to fetch appointment reasons");
    }
};

const getAppointmentReasonForPatient = async (providerid, departmentid, patientReason, existing) => {
    const reasons = await getPatientAppointmentReasons(providerid, departmentid, existing);
    const matchedReason = reasons.find(reason => reason.description.toLowerCase().includes((patientReason || '').toLowerCase()));
    return matchedReason ? matchedReason.reasonid : (reasons.length > 0 ? reasons[0].reasonid : null);
};


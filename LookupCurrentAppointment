const formatDate = (date) => {
    const d = new Date(date);
    return `${d.getMonth() + 1}/${d.getDate()}/${d.getFullYear()}`;
};

const getBooked = async (patientid, departmentid) => {
    const url = `${athena.getBaseUrl()}/v1/${practiceid}/appointments/booked`;
    const today = new Date();
    const sixMonthsFromNow = new Date(today); // Create a new Date object
    sixMonthsFromNow.setDate(today.getDate() + 180);

    if (departmentid === undefined) {
        departmentid = 1;
    }
    if (!cachedToken) {
        cachedToken = await athena.getToken();
    }

    const headers = {
        'Authorization': `Bearer ${cachedToken.access_token}`,
    };

    try {
        const response = await axios.get(url, {
            headers,
            params: {
                patientid: patientid,
                startdate: formatDate(today),
                enddate: formatDate(sixMonthsFromNow),
                departmentid: departmentid
            },
            timeout: 30000
        });

        // Log the entire response
        console.log("📅 Full API Response:", JSON.stringify(response.data, null, 2));

        if (!response.data || !response.data.appointments || response.data.appointments.length === 0) {
            console.error("❌ No booked appointment found for patient:", patientid);
            return { message: "No Appointments Found" };
        }

        // Ensure response is properly structured
        const bookedAppointments = response.data.appointments
            .filter(appointment => appointment.patientid == patientid)
            .map(appointment => ({
                patientid: appointment.patientid,
                appointmentDate: appointment.date,
                appointmentTime: appointment.starttime,
                appointmentid: appointment.appointmentid,
                providerid: appointment.providerid

            }));

        if (bookedAppointments.length === 0) {
            console.log("❌ No matching booked appointments found.");
            return { message: "No Appointments Found" };
        }

        console.log("✅ Found booked appointments:", JSON.stringify(bookedAppointments, null, 2));
        return bookedAppointments;

    } catch (error) {
        console.error('❌ Error in getBooked:', error.response ? error.response.data : error.message);
        return { error: 'Unknown error from Athena API' };
    }
};



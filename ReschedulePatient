            return { 
                statusCode: 400, 
                body: JSON.stringify({ error: "Missing or empty request body" }) 
            };
        }
        let payload;
        try {
            payload = JSON.parse(event.body);
        } catch (error) {
            return { 
                statusCode: 400, 
                body: JSON.stringify({ error: "Invalid JSON format" }) 
            };
        }
        console.log("Parsed payload:", payload);

        const { patientid, appointmentid, appointmentDate, appointmentTime, providerid, departmentid, reasonid, reason, newappointmentid, appointmenttypeid} = payload.args;
        console.log("Extracted variables:", { patientid, appointmentid, appointmentDate, appointmentTime, providerid, departmentid, reasonid, reason, newappointmentid, appointmenttypeid});
       cachedToken = await getAuthToken({isProd: true});
 


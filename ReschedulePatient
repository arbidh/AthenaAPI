};

const reschedulePatient = async (reasonid, appointmentid, newappointmentid, patientid, rescheduleReason, providerid,appointmenttypeid,departmentid) => {
    if (!appointmentid || !newappointmentid) {
        console.error("❌ Error: appointmentid or newappointmentid is undefined.");
        return { error: "Invalid appointment ID" };
    }

    console.log(`📅 Rescheduling appointment ${appointmentid} to ${newappointmentid} for patient ${patientid}`);

    const url = `https://api.platform.athenahealth.com/v1/${practiceid}/appointments/${appointmentid}/reschedule`;

    console.log("🔗 API URL:", url);

    const headers = {
        'Authorization': `Bearer ${cachedToken.access_token}`,
        'Content-Type': 'application/x-www-form-urlencoded',
    };

    const body = new URLSearchParams({
        newappointmentid: newappointmentid,
        appointmentid: appointmentid,
        patientid: patientid,
        bypasscheduletimechecks: true,
        ignoreschedulablepermission: true,
        providerid: providerid,
        departmentid: departmentid,
        reschedulereason: rescheduleReason
    });

    console.log("📤 Sending API request with body:", body.toString());

    try {
        const response = await axios.put(url, body.toString(), { headers, timeout: 90000 });
        console.log("✅ Successfully rescheduled appointment:", response.data);
        return JSON.stringify({ message: `Successfully rescheduled appointment: ${response.data}` });
    } catch (error) {
        console.error("❌ Error in reschedulePatient:", error.response?.data || error.message);

        if (error.response) {
            return { error: error.response?.data || error.message  };
        } else if (error.request) {
            return { error: 'Network Error: Failed to send request' };
        } else {
            return { error: 'Unexpected Error: Failed to process request' };
        }
    }
};



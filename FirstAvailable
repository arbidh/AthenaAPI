        if (!event.body || event.body.trim() === "") {
            return { 
                statusCode: 400, 
                body: JSON.stringify({ error: "Missing or empty request body" }) 
            };
        }
        // use your AI secret key here 
        let payload;
        try {
            payload = JSON.parse(event.body);
        } catch (error) {
            return { 
                statusCode: 400, 
                body: JSON.stringify({ error: "Invalid JSON format" }) 
            };
        }
        console.log("Parsed payload:", payload);
        
        const {providerid,appointmentDate,appointmentTime, patientid, departmentid, appointmenttypeid} = payload.args;

        // Ensure we have a valid token before making any API call.
       
            cachedToken = await athena.getToken();
        
        
        const patientResponse = await bookPatient(providerid,appointmentDate,appointmentTime, patientid, -1, departmentid, appointmenttypeid);
        console.log("Patient Response:", patientResponse);

        return {
            statusCode: 200,
            body: JSON.stringify(patientResponse)
        };
        
    } catch (error) {
        console.error('Error in handler:', error.message);
        // If this is an axios/Athena API error object, forward its status and body
        if (error && error.isAxiosError && error.response) {
            return {
                statusCode: error.response.status || 500,
                body: JSON.stringify(error.response.data || { message: error.message }),
            };
        }
        // If the thrown error is a crafted object with status/data, forward it
        if (error && error.status && error.data) {
            return {
                statusCode: error.status,
                body: JSON.stringify(error.data),
            };
        }

        return {
            statusCode: 500,
            body: JSON.stringify({ error: 'Internal Server Error', message: error.message }),
        };
    }
};

};
const getAuthToken = async ({ isProd }) => {
    try {
      const response = await axios.post('https://pdphr49frb.execute-api.us-west-1.amazonaws.com/Production/GetAuthToken', {
        args: {
          isProd
        }
      });
  
      if (response.status !== 200) {
        throw new Error(`Auth call failed with status ${response.status}: ${response.statusText}`);
      }
  
      const { token, data } = response.data;
  
      if (!token && data?.token) {
        return data.token;
      } else if (!token) {
        throw new Error('No token found in response');
      }
  
      return token;
    } catch (error) {
      console.error('Error fetching token via HTTP:', error.message);
      throw error;
    }
  };

  const findSlots = async (providerid, appointmentDate, appointmentTime, patientid, reasonid, departmentid, appointmenttypeid) => {
    const daysToAdvance = 30;

    // If appointmentDate is provided, parse it to a Date object, else use today
    const start = appointmentDate ? new Date(appointmentDate) : new Date();
    const end = new Date(start);
    end.setDate(start.getDate() + daysToAdvance);

    if (!cachedToken) {
        throw new Error("Missing auth token");
    }

    const url = `https://api.platform.athenahealth.com/v1/${practiceid}/appointments/open`;

    // Create query params
    const params = {
        departmentid,
        bypasscheduletimechecks: true,
        ignoreschedulablepermission: true,
        startdate: formatDate(start),
        enddate: formatDate(end),
    };

    if (appointmentTime) params.time = appointmentTime;
    if (patientid) params.patientid = patientid;
    if (providerid) params.providerid = providerid;
    if (appointmenttypeid) params.appointmenttypeid = appointmenttypeid;

    console.log("🔍 Finding slots with params:", params);

    try {
        const response = await axios.get(url, {
            headers: { Authorization: `Bearer ${cachedToken.access_token}` },
            params
        });

        console.log("📌 Slots found:", response.data);

        let availableSlots = response.data.appointments || [];

        // Filter out slots based on date/time validity and types
        availableSlots = availableSlots.filter(slot => {
            if (!slot.starttime || !slot.date) return false;

            const formattedDate = formatDateToISO(slot.date);
            const formattedStartTime = slot.starttime.length === 5 ? `${slot.starttime}:00` : slot.starttime;
            const slotDateTimeString = `${formattedDate}T${formattedStartTime}Z`;

            const slotDate = new Date(slotDateTimeString);
            if (isNaN(slotDate.getTime())) {
                console.warn("⚠️ Invalid date format for slot:", slotDateTimeString);
                return false;
            }

            return slotDate >= new Date() &&
                !slot.appointmenttype?.toUpperCase().includes("NURS") &&
                !slot.appointmenttype?.toUpperCase().includes("IV");
                !slot.appointmenttype?.toUpperCase().includes("ULTRASOUND");
        });

        console.log("🔍 Filtered Slots:", JSON.stringify(availableSlots, null, 2));
        return availableSlots;
    } catch (error) {
        console.error("❌ Error finding slots:", error.response?.data || error.message);
        throw new Error("Failed to fetch available slots");
    }
};
function formatDateToISO(dateString) {
    const dateParts = dateString.split("/");
    if (dateParts.length === 3) {
        return `${dateParts[2]}-${dateParts[0].padStart(2, "0")}-${dateParts[1].padStart(2, "0")}`;
    }
    return dateString; // Return as is if it's already in the correct format
}
const getTokenFromSecretsManager = async () => {
    try {
        const secretValue = await secretsManager.getSecretValue({ SecretId: SECRET_ID }).promise();
        const tokenData = JSON.parse(secretValue.SecretString);

        if (Date.now() < tokenData.expires_at) {
            console.log("Using cached token");
            return tokenData;
        }

        return await getOAuthToken();
    } catch (error) {
        console.error('Error reading token from Secrets Manager:', error);
        return await getOAuthToken();
    }
};

const getOAuthToken = async () => {
    const url = 'https://api.platform.athenahealth.com/oauth2/v1/token';
    const client_id = "";//add client_id
    const client_secret = "" ;//add client_secret
    const data = new URLSearchParams({
        grant_type: 'client_credentials',
        client_id:client_id,
        client_secret: client_secret,
        scope: 'athena/service/Athenanet.MDP.*',
    });
    try {
        console.log("Attempting to fetch OAuth token...");

        const response = await axios.post(url, data.toString(), {
           headers: {
               'Content-Type': 'application/x-www-form-urlencoded'
           },
        });

        console.log("Token fetched successfully:", response.data);

        const tokenData = {
            access_token: response.data.access_token,
            expires_at: Date.now() + response.data.expires_in * 1000,
        };

        await secretsManager.putSecretValue({
            SecretId: SECRET_ID,
            SecretString: JSON.stringify(tokenData),
        }).promise();

        return tokenData;
    } catch (error) {
        console.error('Error fetching OAuth token:', error.response?.data || error.message);
        throw new Error("Failed to fetch token");
    }
};
const formatDate = (date) => {
    const d = new Date(date);
    return `${d.getMonth() + 1}/${d.getDate()}/${d.getFullYear()}`;
};

const bookPatient = async (providerid,appointmentDate,appointmentTime, patientid, reasonid, departmentid, appointmenttypeid) => {
   
    const slot = await findSlots(providerid,appointmentDate,appointmentTime, patientid, reasonid, departmentid, appointmenttypeid);

    if (!patientid || isNaN(patientid)) {
